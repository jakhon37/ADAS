{
  "_comment": "ADAS Core BENCH profile. It runs on a machine with no TensorRT engines: both perception backends are MOCKS that FABRICATE their output, which is why allow_mock is true and why this file must never be used in a vehicle. Every key below is validated - an unknown key is a hard error - so this doubles as the complete key reference. The vehicle profile (yolox + ufld + a CALIBRATED camera + a real ego speed source) is in README.md under Configuration.",
  "schema_version": 2,
  "fps": 20,
  "log_level": "INFO",
  "log_format": "text",
  "allow_mock": true,

  "detector": {
    "backend": "mock",
    "model_path": "models/yolox_nano.engine",
    "confidence_threshold": 0.35,
    "iou_threshold": 0.5,
    "max_detections": 100,
    "input_size": 416,
    "class_ids": "road_users",
    "layout": "auto",
    "pre_nms_topk": 300
  },

  "lane": {
    "backend": "mock",
    "model_path": "models/ufldv2_culane_res18.engine",
    "dataset": "culane",
    "min_confidence": 0.0,
    "every_n_frames": 1,
    "max_age_frames": 3,
    "allow_unavailable": false
  },

  "depth": {
    "backend": "off",
    "model_path": "models/midas_v21_small_256.engine",
    "cadence_frames": 5,
    "require_engine": false
  },

  "camera": {
    "enabled": true,
    "image_width": 1280,
    "image_height": 720,
    "fx": 910.0,
    "fy": 910.0,
    "cx": 640.0,
    "cy": 360.0,
    "mount_height_m": 1.3,
    "pitch_deg": 2.0,
    "calibrated": false,
    "label": "uncalibrated-default"
  },

  "ego": {
    "source": "none",
    "speed_mps": 0.0,
    "file": "",
    "max_age_s": 0.5,
    "accel_authority_mps2": 2.5,
    "brake_authority_mps2": 8.0,
    "drag_per_s": 0.02,
    "actuator_tau_s": 0.15
  },

  "tracker": {
    "max_missed_frames": 5,
    "association_threshold_px": 120.0,
    "focal_length_px": 910.0,
    "object_height_m": 1.5,
    "min_box_height_px": 1.0,
    "max_distance_m": 200.0,
    "confirm_hits": 3,
    "confirm_window": 5,
    "min_range_box_height_px": 8.0,
    "box_sigma_px": 1.5,
    "jerk_psd": 1.0,
    "max_detections": 64,
    "max_tracks": 64,
    "use_class_heights": true,
    "use_geometry_range": true
  },

  "planner": {
    "cruise_speed_mps": 15.0,
    "min_follow_distance_m": 12.0,
    "max_steering_deg": 22.0,
    "time_gap_s": 2.0,
    "max_decel_mps2": 3.0,
    "lane_center_gain": 1.0,
    "ego_lane_half_width_frac": 0.2,
    "max_accel_mps2": 2.0,
    "standstill_gap_m": 4.0,
    "k_distance": 0.4,
    "k_speed": 0.6,
    "aeb_ttc_s": 0.9,
    "warn_ttc_s": 1.6,
    "emergency_decel_mps2": 8.0,
    "mrm_decel_mps2": 3.5,
    "wheelbase_m": 2.8,
    "max_lateral_accel_mps2": 3.0,
    "steering_speed_ref_mps": 12.0,
    "allow_uncalibrated_metric_steering": false
  },

  "controller": {
    "kp_speed": 0.15,
    "ki_speed": 0.05,
    "max_throttle": 1.0,
    "max_brake": 1.0,
    "max_steering_angle_deg": 25.0,
    "steering_deadband_deg": 0.5,
    "accel_authority_mps2": 2.5,
    "brake_authority_mps2": 8.0,
    "speed_deadband_mps": 0.3,
    "speed_hysteresis_mps": 0.15,
    "max_jerk_mps3": 4.0,
    "max_jerk_emergency_mps3": 15.0,
    "throttle_rate_per_s": 2.0,
    "brake_apply_rate_per_s": 5.0,
    "brake_release_rate_per_s": 8.0,
    "integral_limit_mps2": 1.0
  },

  "safety": {
    "max_speed_mps": 33.0,
    "max_acceleration_mps2": 3.0,
    "max_deceleration_mps2": 8.0,
    "max_steering_rate_rad_s": 0.5,
    "max_steering_angle_rad": 0.52,
    "min_following_distance_m": 2.0,
    "max_lateral_offset_m": 1.5,
    "plan_horizon_s": 1.0,
    "max_jerk_mps3": 4.0,
    "max_jerk_emergency_mps3": 15.0,
    "max_lateral_accel_mps2": 4.5,
    "wheelbase_m": 2.8,
    "max_road_wheel_rad": 0.0,
    "brake_authority_mps2": 8.0,
    "accel_authority_mps2": 2.5,
    "standstill_gap_m": 4.0,
    "reaction_time_s": 0.6,
    "ego_brake_capability_mps2": 6.0,
    "lead_brake_capability_mps2": 8.0,
    "ttc_brake_s": 0.9,
    "ttc_warn_s": 1.6,
    "comfort_decel_mps2": 3.0,
    "mrm_decel_mps2": 3.5,
    "limited_after_dropouts": 1,
    "mrm_after_dropouts": 3,
    "disengage_after_frames": 40,
    "recovery_frames": 10
  },

  "source": {
    "type": "synthetic",
    "uri": "",
    "width": 1280,
    "height": 720,
    "loop": false,
    "reconnect_attempts": 3,
    "reconnect_delay_s": 1.0
  },

  "health": {
    "enabled": false,
    "bind": "127.0.0.1",
    "port": 8090,
    "allow_remote": false,
    "token_file": "",
    "max_connections": 16,
    "required": false
  },

  "events": {
    "enabled": false,
    "path": "",
    "fsync": "critical",
    "fsync_interval_s": 1.0,
    "max_mb": 32.0,
    "backups": 3,
    "min_free_mb": 64.0,
    "strict": false
  }
}
